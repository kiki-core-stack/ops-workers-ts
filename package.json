{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build:internal --outdir=./dist",
    "build:internal": "rm -rf ./dist && NODE_ENV=production bun --env-file=./.env.production.local build ./src/index.ts --minify --production --target bun",
    "compile": "bun run build:internal --compile --outfile ./dist/index",
    "dev": "NODE_ENV=development bun --env-file=./.env.development.local --watch run ./src/index.ts",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kcs-project/pack": "git+https://github.com/kiki-core-stack/pack#e3540e4d067219b39cdc21ff9db89067621262b0",
    "@kikiutils/mongoose": "^7.0.3",
    "@kikiutils/shared": "^18.0.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "mongoose": "^9.9.3",
    "nodemailer": "^9.0.5",
    "p-mutex": "^1.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@kikiutils/eslint-config": "^9.2.0",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/bun": "^1.4.0",
    "eslint": "^10.8.1",
    "knip": "^6.32.2",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript": "^6.0.3"
  }
}
