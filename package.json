{
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "NODE_ENV=production bun run ./build.ts",
    "dev": "NODE_ENV=development nodemon",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --cache --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint --cache --concurrency=auto --fix --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kcs-project/pack": "git+https://github.com/kiki-core-stack/pack#840071ea46fdd148d2edee06b7641e5975a00067",
    "@kikiutils/mongoose": "^9.0.3",
    "@kikiutils/shared": "^20.1.2",
    "axios": "^1.21.1",
    "bullmq": "^6.7.6",
    "es-toolkit": "^1.53.2",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "mongoose": "^9.12.1",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.5.0",
    "p-mutex": "^1.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@kikiutils/eslint-config": "^11.0.1",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "knip": "^6.45.1",
    "nodemon": "^3.1.14",
    "pretty-bytes": "^7.2.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
