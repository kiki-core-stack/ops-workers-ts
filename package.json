{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build:internal --outdir=./dist",
    "build:internal": "rm -rf ./dist && NODE_ENV=production bun --env-file=./.env.production.local build ./src/index.ts --minify --production --target bun",
    "compile": "bun run build:internal --compile --outfile ./dist/index",
    "dev": "NODE_ENV=development bun --env-file=./.env.development.local --watch run ./src/index.ts",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kcs-project/pack": "git+https://github.com/kiki-core-stack/pack#f3cecb5a3072a6f6604577355fb47a4d8ac1f98f",
    "@kikiutils/mongoose": "^9.0.1",
    "@kikiutils/shared": "^18.3.0",
    "axios": "^1.20.0",
    "bullmq": "^6.3.12",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "file-type": "^22.1.1",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "lru-cache": "^11.5.3",
    "mongoose": "^9.11.1",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.1.0",
    "p-mutex": "^1.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@kikiutils/eslint-config": "^9.3.0",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/bun": "^1.4.3",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "typescript": "^6.0.3"
  }
}
